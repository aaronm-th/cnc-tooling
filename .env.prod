DEBUG=0
SECRET_KEY=ein-super-langer-sicherer-zufälliger-prod-key-12345
DJANGO_SETTINGS_MODULE=config.settings.prod

# Erlaubte IPs/Hosts für deinen Mini-PC
ALLOWED_HOSTS=192.168.0.XYZ,localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://192.168.0.XYZ
CSRF_TRUSTED_ORIGINS=http://192.168.0.XYZ

# Postgres Konfiguration
POSTGRES_DB=timestamper_prod
POSTGRES_USER=postgres_admin
POSTGRES_PASSWORD=wähle-ein-sicheres-passwort
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Celery & Redis
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0