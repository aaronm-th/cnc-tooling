# Stage 1: Der Build-Prozess (Node.js wird nur hier benötigt)
FROM node:20-alpine AS build-stage
WORKDIR /app
COPY package*.json ./
RUN npm install
COPY . .

# Argument von docker-compose empfangen und für Vite bereitstellen
ARG VITE_API_URL
ENV VITE_API_URL=$VITE_API_URL

# Das komprimiert und optimiert dein Vue-Frontend in den Ordner /app/dist
RUN npm run build

# Stage 2: Der Produktions-Server (Schlankes Nginx ohne Node.js)
FROM nginx:stable-alpine AS production-stage

# Kopiere die fertigen Dateien aus Stage 1 direkt in den Nginx-Webserver-Ordner
COPY --from=build-stage /app/dist /usr/share/nginx/html

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]